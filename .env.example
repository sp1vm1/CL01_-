# 데이터 공급자: codef | mock
LEDGER_PROVIDER=mock

# CODEF (https://codef.io) 계정 페이지에서 발급
CODEF_ENV=sandbox            # sandbox | demo | api
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=            # 계정 페이지의 RSA 공개키 (base64 한 줄)

# 연결할 은행 계정. 세미콜론으로 여러 개. 형식: 기관코드:아이디:비밀번호
# 기관코드는 ledger/providers/banks.py 참고 (국민 0004, 신한 0088, 토스뱅크 0092 ...)
# 비밀번호는 sync 시 CODEF 공개키로 암호화되어 전송되며 로컬에는 connectedId만 저장됩니다.
CODEF_BANK_LOGINS=

# 저장 위치와 자동 갱신 주기(분)
LEDGER_DB=data/ledger.db
LEDGER_REFRESH_MINUTES=10
